{
  "datasets": [
    {
      "name": "e7bc7f75",
      "displayName": "Revenue Over Time",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  sales_transactions"
      ],
      "catalog": "samples",
      "schema": "bakehouse"
    },
    {
      "name": "7709969a",
      "displayName": "Sales by Franchise Location",
      "queryLines": [
        "SELECT\n",
        "  f.name,\n",
        "  f.city,\n",
        "  f.district,\n",
        "  t.*\n",
        "FROM\n",
        "  sales_transactions t\n",
        "    JOIN sales_franchises f\n",
        "      ON t.franchiseID = f.franchiseID"
      ],
      "catalog": "samples",
      "schema": "bakehouse"
    },
    {
      "name": "ffe8900c",
      "displayName": "Customer Demographics",
      "queryLines": [
        "SELECT\n",
        "  c.gender,\n",
        "  c.country,\n",
        "  c.continent,\n",
        "  c.city,\n",
        "  c.state,\n",
        "  t.*\n",
        "FROM\n",
        "  sales_transactions t\n",
        "    JOIN sales_customers c\n",
        "      ON t.customerID = c.customerID"
      ],
      "catalog": "samples",
      "schema": "bakehouse"
    }
  ],
